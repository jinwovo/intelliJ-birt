# local.properties로 복사해서 이 PC의 경로로 바꿈 (local.properties는 git에 안 올림)

# 이클립스(BIRT 디자이너 4.8 설치된 것)의 plugins 폴더 — render 컴파일 + 설계 화면용 번들(render/bundles.txt 목록)을 플러그인에 넣음
eclipsePlugins=C:/path/to/eclipse/plugins

# (선택) 설치된 IntelliJ — verifyPlugin 호환 검사 대상에 넣음 (컴파일 SDK는 Gradle이 2025.1을 받아서 씀)
ideaPath=C:/Program Files/JetBrains/IntelliJ IDEA 2026.2.3
